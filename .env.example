# Copy this file to .env for local development.
# Replace placeholder values locally. NEVER commit .env or real API keys.

# Xzuff App Hub upload authorization token (used by the current App Hub API)
XZUFF_HUB_UPLOAD_TOKEN=replace-with-a-long-random-token

# Appwrite project settings (reserved for the Appwrite storage adapter)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace-with-your-project-id
APPWRITE_API_KEY=replace-with-your-server-api-key
APPWRITE_BUCKET_ID=replace-with-your-storage-bucket-id

# Optional App Hub service settings
XZUFF_HUB_BIND=127.0.0.1:8787
XZUFF_HUB_DB=data/xzuff-app-hub.sqlite3
XZUFF_HUB_STORAGE=data/packages
